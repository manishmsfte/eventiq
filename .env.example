PORT=3000
SESSION_SECRET=replace-with-a-random-session-secret
BOOTSTRAP_API_TOKEN=replace-with-a-random-bootstrap-token

# Login credentials are read from metadata container login-user documents.

# Preferred: AAD token auth for Cosmos DB
COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
AZURE_TENANT_ID=your-tenant-id

# For local dev without client secret, leave these empty and use `az login`.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional fallback only if key auth is enabled on Cosmos account
COSMOS_DB_CONNECTION_STRING=

COSMOS_DB_DATABASE=hol-registrations
COSMOS_DB_EVENTS_CONTAINER=events
COSMOS_DB_REGISTRATIONS_CONTAINER=registrations
COSMOS_DB_FEEDBACK_CONTAINER=feedback
COSMOS_DB_METADATA_CONTAINER=metadata
COSMOS_DB_PREFERRED_LOCATIONS=East US
COSMOS_DB_AUTO_PROVISION=false

# Optional SMTP settings for automated emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@labautomation.local

# Optional: Power Automate HTTP trigger URL for notifications when SMTP is unavailable
POWER_AUTOMATE_WEBHOOK_URL=

# Comma-separated Microsoft identities allowed to view unmasked PII in dashboards/reports.
# Everyone else sees masked registration fields.
PII_VIEWER_ALLOWLIST=
